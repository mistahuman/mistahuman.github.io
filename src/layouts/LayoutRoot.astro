---
import '@styles/global.css';
import {
  THEME_PICKER,
  DEFAULT_THEME,
  SITE_NAME,
  SITE_TITLE,
  SITE_DESCRIPTION,
  SITE_AUTHOR,
  SITE_LOCALE,
  SITE_OG_IMAGE,
  type SeoProps,
} from '@config';

// The only place that writes <head>. Pages don't reach it directly: they pass their
// SEO through <Layout>, which forwards it here.
const {
  title,
  description = SITE_DESCRIPTION,
  image = SITE_OG_IMAGE,
  imageAlt,
  type = 'website',
  publishedDate,
  tags = [],
  noindex = false,
} = Astro.props as SeoProps;

// `site` is set in astro.config.mjs, so these are always absolute.
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site);
// An absolute `image` (an external URL) wins over the base; a /public path resolves against it.
const ogImage = new URL(image, Astro.site);

// The tab title carries the site name; the Open Graph title does not, since the
// card already shows the site alongside it.
const pageTitle = title ? `${title} · ${SITE_NAME}` : SITE_TITLE;

const jsonLd =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        image: ogImage.href,
        url: canonical.href,
        ...(publishedDate ? { datePublished: publishedDate } : {}),
        ...(tags.length > 0 ? { keywords: tags.join(', ') } : {}),
        author: { '@type': 'Person', name: SITE_AUTHOR },
      }
    : null;
---

<!doctype html>
<!-- change themes or use a custom theme https://themes.skeleton.dev/themes/create -->
<html lang="en" data-theme={DEFAULT_THEME}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE_AUTHOR} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={SITE_LOCALE} />
    <meta property="og:title" content={title ?? SITE_TITLE} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {
      type === 'article' && (
        <>
          {/* Open Graph wants ISO 8601; the frontmatter date is day-precision. */}
          {publishedDate && (
            <meta property="article:published_time" content={`${publishedDate}T00:00:00Z`} />
          )}
          <meta property="article:author" content={SITE_AUTHOR} />
          {tags.map((tag) => (
            <meta property="article:tag" content={tag} />
          ))}
        </>
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? SITE_TITLE} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />}

    <!-- Theme and Mode -->
    <script is:inline define:vars={{ themePicker: THEME_PICKER, defaultTheme: DEFAULT_THEME }}>
      function applyTheme(document) {
        // Picker disabled: the server-rendered data-theme already holds the default.
        if (!themePicker) return;
        const storedTheme = localStorage.getItem('theme');
        const theme = storedTheme ?? defaultTheme;
        document.documentElement.setAttribute('data-theme', theme);
      }

      function applyMode(document) {
        const storedMode = localStorage.getItem('mode');
        const preferredMode = window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light';
        const defaultMode = 'dark';
        const mode = storedMode ?? preferredMode ?? defaultMode;
        document.documentElement.setAttribute('data-mode', mode);
      }

      applyTheme(document);
      applyMode(document);

      document.addEventListener('astro:before-swap', (event) => {
        applyTheme(event.newDocument);
        applyMode(event.newDocument);
      });
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
