---
import BlogListItem from '@components/generic/BlogListItem.astro';
import { groupByYear, type Post } from '../../data/blog';

// The year-grouped post list, shared by the blog index and the tag routes so the two
// cannot drift apart. Expects posts already filtered and sorted newest-first.
interface Props {
  posts: Post[];
  empty?: string;
}

const { posts, empty = 'nothing here yet — check back soon.' } = Astro.props;
const years = groupByYear(posts);
---

{
  posts.length > 0 ? (
    <div class="space-y-14">
      {years.map(([year, yearPosts]) => (
        <section>
          <div class="flex items-center gap-4 mb-2">
            <h2 class="text-sm font-semibold tracking-widest text-surface-600-400">{year}</h2>
            <hr class="hr flex-1 border-surface-200-800" />
            <span class="text-xs text-surface-600-400">
              {yearPosts.length} {yearPosts.length === 1 ? 'post' : 'posts'}
            </span>
          </div>

          <ul>
            {yearPosts.map((post) => (
              <li class="border-b border-surface-200-800 last:border-b-0">
                <BlogListItem post={post} />
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  ) : (
    <p class="text-surface-600-400">{empty}</p>
  )
}
