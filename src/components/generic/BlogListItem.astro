---
import { ArrowRight, Clock } from '@lucide/svelte';
import { readingTime, shortDate, type Post } from '../../data/blog';

// One row of the blog index: metadata line, title, blurb, tags, optional thumbnail.
// The whole row is the link; the divider lives on the parent <li> so it stays full
// width while the hover surface is inset.
interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, date, tags, cover, coverAlt } = post.data;
---

<a
  href={`/blog/${post.id}`}
  class="group flex gap-5 no-underline py-6 px-4 -mx-4 rounded-container transition-colors hover:bg-surface-100-900"
>
  <div class="flex-1 min-w-0 space-y-2">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-surface-600-400">
      <time datetime={date} class="font-semibold text-primary-500">{shortDate(date)}</time>
      <span class="flex items-center gap-1">
        <Clock class="w-3 h-3" />
        {readingTime(post)} min read
      </span>
    </div>

    <h2
      class="h4 font-semibold flex items-center gap-2 group-hover:text-primary-500 transition-colors"
    >
      <span>{title}</span>
      <ArrowRight
        class="w-4 h-4 shrink-0 opacity-0 -translate-x-1 transition-all group-hover:opacity-100 group-hover:translate-x-0"
      />
    </h2>

    <p class="text-surface-600-400 text-sm">{description}</p>

    {
      tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 pt-1">
          {tags.map((tag) => (
            <span class="chip preset-outlined-primary-500" style="--chip-size: var(--text-xs)">
              {tag}
            </span>
          ))}
        </div>
      )
    }
  </div>

  {
    cover && (
      <img
        src={cover}
        alt={coverAlt ?? title}
        loading="lazy"
        class="hidden sm:block shrink-0 w-32 md:w-44 aspect-video object-cover rounded-container border border-surface-200-800"
      />
    )
  }
</a>
